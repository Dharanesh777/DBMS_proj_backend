# Copy this file to .env and fill in real values. Never commit .env itself.

# ── Database (Postgres — e.g. a free Neon instance) ─────────────────────────
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSLMODE=require

# ── LLM provider ─────────────────────────────────────────────────────────────
# One of: groq | openai | ollama
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Only needed if LLM_PROVIDER=ollama and it's not running on localhost:11434
OLLAMA_MODEL=llama3

# ── Google Calendar (used by app/services/reminder_app/google_auth.py) ──────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8004/oauth2callback
CALENDAR_ID=primary

# ── Redis (Celery broker/backend — see app/ai_models/reminders/) ────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
# Default user id used by the single-tenant face-recognition session engine
USER_ID=1
